ng.TraceSource.dll&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\Sequencer Plus&quot; /h/k/r/y&#xD;&#xA;if exist &quot;$(TargetDir)Microsoft.Extensions.Logging.dll&quot; xcopy &quot;$(TargetDir)Microsoft.Extensions.Logging.dll&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\Sequencer Plus&quot; /h/k/r/y&#xD;&#xA;if exist &quot;$(TargetDir)Microsoft.Extensions.Options.dll&quot; xcopy &quot;$(TargetDir)Microsoft.Extensions.Options.dll&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\Sequencer Plus&quot; /h/k/r/y&#xD;&#xA;" />
