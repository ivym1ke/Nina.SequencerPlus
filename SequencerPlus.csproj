<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>NINA.Plugin.SequencerPlus</AssemblyName>
    <RootNamespace>NINA.Plugin.SequencerPlus</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SequencerPlus\CVE\ExpressionConverter.cs" />
    <Compile Remove="SequencerPlus\CVE\GlobalConstantView.xaml.cs" />
    <Compile Remove="SequencerPlus\CVE\ISettable.cs" />
    <Compile Remove="SequencerPlus\CVE\Runner.cs" />
    <Compile Remove="SequencerPlus\CVE\RunnerInstruction.cs" />
    <Compile Remove="SequencerPlus\CVE\ValidityConverter.cs" />
    <Compile Remove="SequencerPlus\IfResults.cs" />
    <Compile Remove="SequencerPlus\Instructions\AutofocusAfterInstructions.cs" />
    <Compile Remove="SequencerPlus\Instructions\IfSafe.cs" />
    <Compile Remove="SequencerPlus\Instructions\IfSafeUnsafe.cs" />
    <Compile Remove="SequencerPlus\Instructions\IfUnsafe.cs" />
    <Compile Remove="SequencerPlus\Instructions\RunAutofocus.cs" />
    <Compile Remove="SequencerPlus\Instructions\SequenceBlockView.xaml.cs" />
    <Compile Remove="SequencerPlus\Instructions\SetVariable.cs" />
    <Compile Remove="SequencerPlus\InterruptWait.cs" />
    <Compile Remove="SequencerPlus\PrependToLastImage.cs" />
    <Compile Remove="SequencerPlus\SetConstantView.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="SequencerPlus\CVE\GlobalConstantView.xaml" />
    <Page Remove="SequencerPlus\Instructions\SequenceBlockView.xaml" />
    <Page Remove="SequencerPlus\SetConstantView.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ReachFramework" />
    <Reference Include="System.Net" />
    <Reference Include="System.Printing" />
    <Reference Include="System.Windows" />
    <!-- ToastNotifications — no net10.0-compatible NuGet; reference from local NuGet cache -->
    <Reference Include="ToastNotifications">
      <HintPath>$(UserProfile)\.nuget\packages\toastnotifications\2.5.1\lib\net40\ToastNotifications.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="NINA.Plugin" Version="3.3.0.1037-nightly" />
    <PackageReference Include="NINA.CustomControlLibrary" Version="3.3.0.1037-nightly" />
    <PackageReference Include="NINA.Sequencer.Generators" Version="3.3.0.1037-nightly">
